# Git LFS for Antigravity 2.0 Repository
# Packaged Windows binaries are version-controlled on purpose.
# They are tracked with Git LFS because several of them exceed
# GitHub's hard 100 MB per-file limit (Antigravity.exe = 234.68 MB,
# language_server.exe = 158.68 MB).

*.exe   filter=lfs diff=lfs merge=lfs -text
*.dll   filter=lfs diff=lfs merge=lfs -text
*.pak   filter=lfs diff=lfs merge=lfs -text
*.bin   filter=lfs diff=lfs merge=lfs -text
*.dat   filter=lfs diff=lfs merge=lfs -text
*.asar  filter=lfs diff=lfs merge=lfs -text
